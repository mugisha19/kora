# Kora web (feature 24): serves the Angular app and proxies the API, so the browser talks to one origin.
# ${KORA_API_UPSTREAM} and ${KORA_STORAGE_ORIGIN} are filled in from the environment when the container starts;
# Nginx's own $variables are left as they are.

# WebSocket upgrade for STOMP on /ws.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# HSTS only when a TLS-terminating proxy in front says the request came over HTTPS (never on plain HTTP).
map $http_x_forwarded_proto $kora_hsts {
  https   "max-age=31536000; includeSubDomains";
  default "";
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  # Files go straight to object storage with presigned URLs; API bodies are small.
  client_max_body_size 2m;

  # Docker's DNS, re-resolved: Nginx starts even when the API isn't up yet and follows it when it restarts.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $kora_api http://${KORA_API_UPSTREAM};

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css text/plain application/javascript application/json image/svg+xml;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # The actuator stays private (it listens on another port inside the API container anyway).
  location /actuator {
    return 404;
  }

  location /api/ {
    proxy_pass $kora_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # STOMP over WebSocket; heartbeats keep the connection alive, so the read timeout is long.
  location = /ws {
    proxy_pass $kora_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
  }

  # Bundles with a content hash in their name never change: cache them for a year.
  location ~* "-[A-Za-z0-9_-]{8}\.(js|css)$" {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # The page itself: always revalidated, and each response gets its own CSP nonce for Angular's styles.
  location = /index.html {
    include /etc/nginx/conf.d/security-headers.inc;
    # Revalidated on every visit (never a stale app), yet still eligible for the back/forward cache.
    add_header Cache-Control "no-cache" always;
    sub_filter_once off;
    sub_filter 'NGINX_CSP_NONCE' '$request_id';
  }

  # Everything else: translations and icons revalidate (no hash in their names); unknown paths are app routes.
  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
