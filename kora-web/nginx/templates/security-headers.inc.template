# Security headers for every page and file (feature 24, OWASP A05). Included in each location, because an
# add_header inside a location replaces the ones it would inherit.
#
# CSP: scripts only from this origin; style elements only from this origin or with this response's nonce (Angular
# adds it to the styles it inserts); inline style attributes are allowed (CDK overlays and charts position with
# them). Browsers upload and download attachments directly from object storage, so its origin is allowed for
# connections and images.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-$request_id'; style-src-elem 'self' 'nonce-$request_id'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: ${KORA_STORAGE_ORIGIN}; connect-src 'self' ${KORA_STORAGE_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Strict-Transport-Security $kora_hsts always;
